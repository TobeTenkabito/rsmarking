# RSMarking 环境变量示例：复制为仓库根目录 .env。
# 每次修改后重启 ai_gateway；已启动进程不会自动重载 .env。
# 不要同时取消多个厂商示例的注释。AI_MODEL 决定激活模型，填 Key 不会切换模型。
# 明确的 provider/model 优先于 AI_PROVIDER；裸模型名可用 AI_PROVIDER 指定服务。
# 模型名称仅为配置示例，需以账户实际可调用且支持 tool calling 的模型为准。
# 详见 docs/ai-providers.md。下面默认启用 OpenAI，其余为可替换片段。

AI_MODEL=openai/gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 协议代理 / 自建网关（保留完整模型 ID，包含组织名前缀也可以）
# AI_MODEL=openai/your-model-id
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://your-gateway.example/v1
# Base URL 不要以 /chat/completions 或 /responses 结尾。

# Anthropic 原生 Messages 协议，不能使用 OpenAI 的 /v1 地址
# AI_MODEL=anthropic/claude-sonnet-4-6
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google AI Studio / Gemini 原生协议；GOOGLE_API_KEY 亦可，GEMINI_API_KEY 优先
# AI_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=your-api-key
# 通常无需设置 GEMINI_BASE_URL；原生 Gemini 不要填写 OpenAI 兼容接口地址。

# DeepSeek
# AI_MODEL=deepseek/deepseek-chat
# DEEPSEEK_API_KEY=your-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 阿里云百炼 / 通义千问：使用 OpenAI 兼容协议
# AI_MODEL=dashscope/qwen-plus
# DASHSCOPE_API_KEY=your-api-key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 国际站/其他区域/Coding Plan 的地址与密钥需匹配，按控制台文档替换。

# 火山方舟 / 豆包：model 填账户开通的模型 ID 或 ep- 接入点 ID
# AI_MODEL=ark/your-endpoint-id
# ARK_API_KEY=your-api-key
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 百度千帆 v2：API Key 鉴权，不是旧版 API_KEY + SECRET_KEY 换 access_token
# AI_MODEL=qianfan/ernie-4.0-8k
# QIANFAN_API_KEY=your-api-key
# QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# Moonshot / Kimi
# AI_MODEL=moonshot/kimi-k2-0905-preview
# MOONSHOT_API_KEY=your-api-key
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 智谱 GLM（套餐地址可能不同，以控制台为准）
# AI_MODEL=zhipu/glm-4.5
# ZHIPU_API_KEY=your-api-key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 硅基流动：模型 ID 中的组织名会原样保留
# AI_MODEL=siliconflow/Qwen/Qwen3-8B
# SILICONFLOW_API_KEY=your-api-key
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# OpenRouter：其模型 ID 本身也包含厂商前缀
# AI_MODEL=openrouter/anthropic/claude-sonnet-4.6
# OPENROUTER_API_KEY=your-api-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Azure OpenAI：模型部分为部署名，另需该部署支持的 API 版本
# AI_MODEL=azure/your-deployment-name
# AZURE_API_KEY=your-api-key
# AZURE_BASE_URL=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-10-21

# Ollama：先在本机安装一个支持工具调用的模型
# AI_MODEL=ollama_chat/qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# 可选：不写 AI_MODEL 时，AI_PROVIDER + 对应 *_MODEL 也能选择模型。
# AI_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-4-6
# 无配置时默认为 OpenAI/gpt-4o；未知裸模型 ID 默认按 OpenAI 协议处理。

# 全局覆盖项优先于厂商变量，会影响聊天和图像请求。切换厂商时注意清理旧覆盖项。
# AI_API_KEY=
# AI_BASE_URL=
# 已有系统/进程环境变量优先于 .env；空值和样例 Key 不视为有效密钥。
# 各厂商密钥相互隔离，不会回退借用 OPENAI_API_KEY。

# 超时单位：毫秒。AI_MAX_TOKENS 为输出预算（推理模型可能包含推理 token）。
AI_TIMEOUT=30000
AI_MAX_TOKENS=4096

# 推理模式按厂商适配；不是所有模型/网关都支持以下参数。
AI_REASONING_ENABLED=false
AI_REASONING_EFFORT=medium
AI_REASONING_STYLE=auto
# gpt-6-sol 使用当前 Chat Completions Agent 时，将上面的配置改为：
# AI_MODEL=openai/gpt-6-sol
# AI_REASONING_ENABLED=true
# AI_REASONING_EFFORT=none
# AI_REASONING_STYLE=openai
# ENABLED=true 用于发送显式 none；false 会省略参数，由模型使用默认推理设置。
# gpt-6.1-sol 的工具调用必须使用 Responses API，当前 Agent 尚未接入。
# AI_REASONING_BUDGET_TOKENS=2048
# Anthropic thinking 的预算必须小于 AI_MAX_TOKENS。
# AI_REASONING_MODEL_ALLOWLIST=openai/o3-*,deepseek/deepseek-reasoner,dashscope/qwen3-*
# AI_REASONING_EXTRA_JSON={"extra_body":{"enable_thinking":true}}
# 自定义模型/代理对参数支持不同，可显式使用 reasoning style/allowlist 配置。

# 可选图像模型，独立选择厂商；不设置则不启用图像模型。
# AI_IMAGE_MODEL=openai/gpt-image-1
# AI_IMAGE_DOWNLOAD_TIMEOUT=30
# AI_ARTIFACT_DIR=storage/ai_artifacts

# 危险管理操作默认关闭
RS_ENABLE_ADMIN_OPERATIONS=false
RS_ADMIN_TOKEN=

# -------------------------------------------------------------
# Executor sandbox
# -------------------------------------------------------------
# Host directories from which raster inputs may be copied into the sandbox.
# Defaults to this repository's storage directory. Separate multiple roots
# with the platform path separator (";" on Windows, ":" on Linux).
# SANDBOX_ALLOWED_INPUT_ROOTS=F:\rsmarking\storage

# -------------------------------------------------------------
# Raster tile service
# -------------------------------------------------------------
# "per_request" is the safest default. "thread_local" can reuse RasterIO
# datasets on dedicated worker threads, but should be load-tested before use.
TILE_RASTER_OPEN_MODE=per_request
TILE_RESAMPLING_MODE=quality
TILE_ALPHA_MODE=auto
TILE_PNG_COMPRESS_LEVEL=1

# Bound client-controlled work and tile coordinates.
TILE_MAX_BANDS=4
TILE_MAX_ZOOM=24

# Browser/proxy revalidation. Rendered PNGs also use an ETag derived from their
# bytes, while source mtime/size remain part of the internal tile cache key.
TILE_HTTP_CACHE_MAX_AGE_SECONDS=60
TILE_HTTP_CACHE_STALE_WHILE_REVALIDATE_SECONDS=300

# Metadata and RasterIO engine caches.
TILE_PATH_CACHE_TTL_SECONDS=30
TILE_PATH_CACHE_MAXSIZE=1024
TILE_ENGINE_CACHE_SIZE=16

# Enable per-stage timing in tile-service logs while profiling.
TILE_PROFILE=false
